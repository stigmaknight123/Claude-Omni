#!/usr/bin/env bash
# Launch Claude Code against the local Zen proxy.
#
# Starts the proxy if it isn't up, picks a model that's actually alive, and
# forces every model slot to it before exec'ing the real `claude`.
set -euo pipefail

MODEL="${DEFAULT_ZEN_MODEL:-deepseek-v4-flash-free}"
MODEL_EXPLICIT=0
MODE="zen"                 # zen | go | openrouter | groq | cerebras | gemini | mistral | together | nvidia | huggingface
PORT="${ZEN_PROXY_PORT:-8787}"
HEALTH="http://127.0.0.1:${PORT}/health"
DIR="$HOME/.zen-claude"
START="$DIR/start.sh"
LOG="$DIR/proxy.log"
MARK="$DIR/.zen-base-url"
STATE="$DIR/.state"
VERSION="1.3.0"
MODE_EXPLICIT=0
FROM_STATE=0

# Auto-update on launch: pull the repo and re-install if we're behind.
# Set CLAUDE_OMNI_NO_UPDATE=1 to disable.
auto_update() {
  [ "${CLAUDE_OMNI_NO_UPDATE:-0}" = "1" ] && return 0
  case "${1:-}" in
    --status|--list|--doctor|--update|--version|--reset|--uninstall|-h|--help) return 0 ;;
  esac
  local src before after
  src="$(cat "$DIR/.repo-path" 2>/dev/null || true)"
  [ -n "$src" ] && [ -d "$src/.git" ] || return 0
  before="$(git -C "$src" rev-parse HEAD 2>/dev/null || true)"
  if command -v timeout >/dev/null 2>&1; then
    timeout 10 git -C "$src" fetch --quiet origin main 2>/dev/null || return 0
  else
    git -C "$src" fetch --quiet origin main 2>/dev/null || return 0
  fi
  after="$(git -C "$src" rev-parse origin/main 2>/dev/null || true)"
  [ -n "$before" ] && [ -n "$after" ] && [ "$before" != "$after" ] || return 0
  echo "claude-omni: update available, applying..."
  ( cd "$src" && git pull --ff-only --quiet origin main && ./install.sh >/dev/null 2>&1 ) || {
    echo "claude-omni: update failed, continuing with current version" >&2
    return 0
  }
  echo "claude-omni: updated, restarting..."
  exec "$0" "$@"
}

auto_update "$@"

usage() {
  cat <<'EOF'
Usage: claude-omni [-m <model>] [--<provider>] [--status|--list] [-- claude args...]

Providers (pick one; default is --zen):
  --zen           OpenCode Zen      (free + pay-per-credit)
  --go            OpenCode Go       (subscription)
  --openrouter    OpenRouter        (the :free lineup)
  --groq          Groq              (free tier)
  --cerebras      Cerebras          (free tier)
  --gemini        Google Gemini     (AI Studio free tier)
  --mistral       Mistral           (free tier)
  --together      Together AI       (free models)
  --nvidia        NVIDIA NIM        (free trial)
  --huggingface   Hugging Face      (free tier)

  -m <model>      Model to use (default: last used, else the provider default)
  --status        Probe every model and show which are live
  --list          List the model ids for the current provider
  --doctor        Check prerequisites, key, proxy, and a model probe
  --update        Git-pull the repo and re-run install.sh
  --reset         Forget the remembered provider/model
  --uninstall     Remove ~/.zen-claude and the launcher
  --version       Print the version
  -h, --help      Show this help

Everything else is forwarded to the real `claude`.
EOF
}

# Env var name holding the API key for the current provider.
key_var() {
  case "$MODE" in
    zen|go)      printf 'ZEN_API_KEY' ;;
    openrouter)  printf 'OPENROUTER_API_KEY' ;;
    groq)        printf 'GROQ_API_KEY' ;;
    cerebras)    printf 'CEREBRAS_API_KEY' ;;
    gemini)      printf 'GEMINI_API_KEY' ;;
    mistral)     printf 'MISTRAL_API_KEY' ;;
    together)    printf 'TOGETHER_API_KEY' ;;
    nvidia)      printf 'NVIDIA_API_KEY' ;;
    huggingface) printf 'HF_TOKEN' ;;
    *)           printf 'ZEN_API_KEY' ;;
  esac
}

key() {
  grep "^$(key_var)=" "$DIR/.env" | cut -d= -f2-
}

# Endpoint the proxy and the probes talk to. All OpenAI chat/completions.
api_base() {
  case "$MODE" in
    zen)         printf 'https://opencode.ai/zen/v1' ;;
    go)          printf 'https://opencode.ai/zen/go/v1' ;;
    openrouter)  printf 'https://openrouter.ai/api/v1' ;;
    groq)        printf 'https://api.groq.com/openai/v1' ;;
    cerebras)    printf 'https://api.cerebras.ai/v1' ;;
    gemini)      printf 'https://generativelanguage.googleapis.com/v1beta/openai' ;;
    mistral)     printf 'https://api.mistral.ai/v1' ;;
    together)    printf 'https://api.together.xyz/v1' ;;
    nvidia)      printf 'https://integrate.api.nvidia.com/v1' ;;
    huggingface) printf 'https://router.huggingface.co/v1' ;;
    *)           printf 'https://opencode.ai/zen/v1' ;;
  esac
}

# Default model per provider (used when nothing is pinned via -m or env).
default_model() {
  case "$MODE" in
    zen)        printf 'deepseek-v4-flash-free' ;;
    go)         printf 'deepseek-v4-flash' ;;
    openrouter) printf 'deepseek/deepseek-chat:free' ;;
    *)          preferred | head -1 ;;   # first curated model for other providers
  esac
}

proxy_up() {
  curl -sf --max-time 2 "$HEALTH" >/dev/null 2>&1
}

# Remember the last provider/model so a bare `claude-omni` resumes it.
load_state() {
  [ -f "$STATE" ] || return 0
  local m mm
  m="$(grep '^MODE=' "$STATE" | cut -d= -f2- || true)"
  case "$m" in zen|go|openrouter|groq|cerebras|gemini|mistral|together|nvidia|huggingface) MODE="$m" ;; esac
  mm="$(grep '^MODEL=' "$STATE" | cut -d= -f2- || true)"
  if [ -n "$mm" ]; then MODEL="$mm"; FROM_STATE=1; fi
}

save_state() {
  printf 'MODE=%s\nMODEL=%s\n' "$MODE" "$MODEL" > "$STATE"
}

start_proxy() {
  local base; base="$(api_base)"
  if proxy_up; then
    # Only restart if the running proxy is on a different endpoint.
    [ "$(cat "$MARK" 2>/dev/null || true)" = "$base" ] && return
    echo "zen-proxy endpoint changed, restarting..."
    local pid; pid="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    sleep 1
  else
    echo "starting zen-proxy..."
  fi
  [ -f "$START" ] || { echo "error: $START not found -- run install.sh" >&2; exit 1; }
  printf '%s\n' "$base" > "$MARK"
  ZEN_API_KEY="$(key)" ZEN_BASE_URL="$base" ZEN_FALLBACK_MODELS="$(ordered_catalog 2>/dev/null | tr '\n' ' ')" nohup "$START" >>"$LOG" 2>&1 &
  for _ in $(seq 1 40); do
    proxy_up && { echo "zen-proxy up (http://127.0.0.1:${PORT})"; return; }
    sleep 0.5
  done
  echo "error: zen-proxy failed to start; see $LOG" >&2
  exit 1
}

# One cheap no-tools call. Models come and go, so "is it in the catalog"
# is not the same question as "does it answer".
model_alive() {
  curl -sf --max-time 25 "$(api_base)/chat/completions" \
    -H "Authorization: Bearer $(key)" -H 'content-type: application/json' \
    -d "{\"model\":\"$1\",\"max_tokens\":600,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    2>/dev/null | grep -q '"choices"'
}

# One cheap probe; echoes ok | limited | dead for a single model.
probe_model() {
  local body
  body="$(curl -s --max-time 25 "$(api_base)/chat/completions" \
    -H "Authorization: Bearer $(key)" -H 'content-type: application/json' \
    -d "{\"model\":\"$1\",\"max_tokens\":16,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    2>/dev/null)"
  if printf '%s' "$body" | grep -q '"choices"'; then
    echo ok
  elif printf '%s' "$body" | grep -qiE 'FreeUsageLimitError|rate limit|free usage|Insufficient balance|CreditsError|quota'; then
    echo limited
  else
    echo dead
  fi
}

# Catalog for the current mode. Zen/Go/OpenRouter are fetched live; the rest
# use a curated static list (see preferred()) since their catalogs are huge or
# their "free" subset isn't marked in the id.
catalog() {
  case "$MODE" in
    zen|go|openrouter) ;;
    *) preferred; return ;;
  esac
  local ids
  ids="$(curl -sf --max-time 10 "$(api_base)/models" \
    -H "Authorization: Bearer $(key)" 2>/dev/null \
    | python3 -c 'import sys,json
for m in json.load(sys.stdin).get("data",[]):
    print(m.get("id",""))' 2>/dev/null)"
  case "$MODE" in
    go)         printf '%s\n' "$ids" | grep -v '\-free$' ;;
    openrouter) printf '%s\n' "$ids" | grep ':free$' ;;
    *)          printf '%s\n' "$ids" | grep '\-free$' ;;
  esac
}

# Soft priority order for the fallback picker (provider-specific, space
# separated). Models not listed are still tried afterward; override with
# ZEN_PREFERRED="id1 id2 ...". Ordered roughly by generosity/reliability.
preferred() {
  if [ -n "${ZEN_PREFERRED:-}" ]; then printf '%s\n' "$ZEN_PREFERRED"; return; fi
  case "$MODE" in
    openrouter)
      printf '%s\n' \
        'nvidia/nemotron-3-ultra-550b-a55b:free' \
        'nvidia/nemotron-3-super-120b-a12b:free' \
        'google/gemma-4-31b-it:free' \
        'google/gemma-4-26b-a4b-it:free' \
        'z-ai/glm-5.2:free' \
        'minimax/minimax-m3:free' \
        'minimax/minimax-m2.7:free' \
        'cohere/north-mini-code:free' ;;
    zen)
      printf '%s\n' \
        'hy3-free' \
        'nemotron-3-ultra-free' \
        'nemotron-3.5-lightning-free' \
        'laguna-s-2.1-free' \
        'mimo-v2.5-free' ;;
    go)
      printf '%s\n' \
        'mimo-v2.5' \
        'longcat-2.0' \
        'hy3' \
        'deepseek-v4-flash' ;;
    groq)
      printf '%s\n' \
        'llama-3.3-70b-versatile' \
        'llama-3.1-8b-instant' \
        'mixtral-8x7b-32768' \
        'gemma2-9b-it' ;;
    cerebras)
      printf '%s\n' \
        'llama3.3-70b' \
        'llama3.1-8b' ;;
    gemini)
      printf '%s\n' \
        'gemini-2.0-flash' \
        'gemini-2.0-flash-lite' \
        'gemini-1.5-flash' ;;
    mistral)
      printf '%s\n' \
        'mistral-small-latest' \
        'open-mistral-nemo' \
        'open-mistral-7b' ;;
    together)
      printf '%s\n' \
        'meta-llama/Llama-3.3-70B-Instruct-Turbo' \
        'deepseek-ai/DeepSeek-R1' \
        'mistralai/Mixtral-8x7B-Instruct-v0.1' ;;
    nvidia)
      printf '%s\n' \
        'meta/llama-3.3-70b-instruct' \
        'deepseek-ai/deepseek-r1' \
        'mistralai/mistral-7b-instruct-v0.3' ;;
    huggingface)
      printf '%s\n' \
        'Qwen/Qwen2.5-Coder-32B-Instruct' \
        'meta-llama/Llama-3.3-70B-Instruct' \
        'deepseek-ai/DeepSeek-R1' ;;
  esac
}

in_list() {
  local w="$1" x
  for x in $2; do [ "$x" = "$w" ] && return 0; done
  return 1
}

# The catalog is fetched fresh every run, so the candidate list is already
# dynamic (new models appear, dead ones vanish). We add a soft priority on top:
# preferred models are tried first, then the rest -- and anything currently
# rate-limited is skipped by the live probe.
ordered_catalog() {
  local all pref m
  all="$(catalog)"
  pref="$(preferred)"
  for m in $pref; do printf '%s\n' "$all" | grep -qx "$m" && echo "$m"; done
  for m in $all; do in_list "$m" "$pref" || echo "$m"; done
}

# The lineup rotates constantly and dead entries stay in the catalog, so a
# hardcoded default goes stale on its own. Fall back to whatever is up.
resolve_model() {
  if model_alive "$MODEL"; then return; fi

  local desc="$MODE models"
  [ "$MODE" = "zen" ] && desc="free models"
  [ "$MODE" = "go" ] && desc="Go models"
  [ "$MODE" = "openrouter" ] && desc="OpenRouter free models"
  if [ "$MODEL_EXPLICIT" = 1 ]; then
    echo "error: model '$MODEL' is not responding." >&2
    echo "       $desc currently listed:" >&2
    catalog | sed 's/^/         /' >&2
    exit 1
  fi

  echo "note: '$MODEL' is not responding, looking for a live model..." >&2
  for m in $(ordered_catalog); do
    [ "$m" = "$MODEL" ] && continue
    if model_alive "$m"; then
      echo "note: using '$m' instead" >&2
      MODEL="$m"
      return
    fi
  done

  echo "error: no model is responding right now." >&2
  echo "       Free lineups rotate and rate-limit often. Try:" >&2
  echo "         claude-omni --openrouter   # a different free lineup" >&2
  echo "         claude-omni --go           # your Go subscription" >&2
  echo "         claude-omni --status       # see responding/rate-limited/dead" >&2
  exit 1
}

status() {
  local endpt
  endpt="$(cat "$MARK" 2>/dev/null || true)"
  if proxy_up; then echo "proxy: UP (http://127.0.0.1:${PORT})"; else echo "proxy: DOWN"; fi
  echo "active provider: $MODE ($(api_base))"
  [ -n "$endpt" ] && echo "running proxy on: $endpt"
  echo ""
  case "$MODE" in
    zen)        echo "Free models in the Zen catalog:" ;;
    go)         echo "Go models (subscription):" ;;
    openrouter) echo "OpenRouter free models:" ;;
    *)          echo "$MODE models:" ;;
  esac
  local m st
  for m in $(ordered_catalog); do
    st="$(probe_model "$m")"
    case "$st" in
      ok)      printf '  \033[32mresponding\033[0m    %s\n' "$m" ;;
      limited) printf '  \033[33mrate-limited\033[0m  %s\n' "$m" ;;
      *)       printf '  \033[31mdead\033[0m          %s\n' "$m" ;;
    esac
  done
}

update() {
  local src pid
  src="$(cat "$DIR/.repo-path" 2>/dev/null || true)"
  [ -n "$src" ] && [ -d "$src/.git" ] || {
    echo "error: can't find the repo (was it moved?). Re-clone and re-run install.sh." >&2
    exit 1
  }
  echo "updating claude-omni from $src ..."
  ( cd "$src" && git pull --ff-only origin main ) || { echo "error: git pull failed" >&2; exit 1; }
  ( cd "$src" && ./install.sh ) || { echo "error: install.sh failed" >&2; exit 1; }
  pid="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
  if [ -n "$pid" ]; then kill "$pid" 2>/dev/null; echo "stopped the proxy; it restarts on the next launch."; fi
  echo "done. Run claude-omni to start."
}

doctor() {
  local bad=0 m st
  echo "claude-omni $VERSION — doctor"
  echo ""

  if command -v node >/dev/null 2>&1; then
    printf '  \033[32mok\033[0m   node %s\n' "$(node -v 2>/dev/null)"
  else
    printf '  \033[31mfail\033[0m node not found (need v18+)\n'; bad=$((bad+1))
  fi
  if command -v python3 >/dev/null 2>&1; then
    printf '  \033[32mok\033[0m   python3\n'
  else
    printf '  \033[31mfail\033[0m python3 not found\n'; bad=$((bad+1))
  fi
  if command -v claude >/dev/null 2>&1; then
    printf '  \033[32mok\033[0m   claude (%s)\n' "$(command -v claude)"
  else
    printf '  \033[31mfail\033[0m claude not found on PATH\n'; bad=$((bad+1))
  fi

  if [ -f "$DIR/.env" ] && [ -n "$(key)" ]; then
    printf '  \033[32mok\033[0m   API key set (%s)\n' "$MODE"
  else
    printf '  \033[31mfail\033[0m API key missing for %s (run install.sh)\n' "$MODE"; bad=$((bad+1))
  fi

  if proxy_up; then
    printf '  \033[32mok\033[0m   proxy up (http://127.0.0.1:%s)\n' "$PORT"
  else
    printf '  \033[33mwarn\033[0m proxy down (starts on launch)\n'
  fi

  if [ -n "$(key)" ]; then
    m="$(default_model)"
    printf '  probe %s: ' "$m"
    st="$(probe_model "$m")"
    case "$st" in
      ok)      printf '\033[32mresponding\033[0m\n' ;;
      limited) printf '\033[33mrate-limited\033[0m\n' ;;
      *)       printf '\033[31mdead\033[0m\n'; bad=$((bad+1)) ;;
    esac
  fi

  echo ""
  if [ "$bad" -eq 0 ]; then
    echo "all good — run claude-omni"
  else
    echo "$bad issue(s) found"
  fi
}

load_state

while [ $# -gt 0 ]; do
  case "$1" in
    -m)       MODEL="$2"; MODEL_EXPLICIT=1; shift 2 ;;
    -m=*)     MODEL="${1#-m=}"; MODEL_EXPLICIT=1; shift ;;
    --go)     MODE="go"; MODE_EXPLICIT=1; shift ;;
    --zen)    MODE="zen"; MODE_EXPLICIT=1; shift ;;
    --openrouter) MODE="openrouter"; MODE_EXPLICIT=1; shift ;;
    --groq)   MODE="groq"; MODE_EXPLICIT=1; shift ;;
    --cerebras) MODE="cerebras"; MODE_EXPLICIT=1; shift ;;
    --gemini) MODE="gemini"; MODE_EXPLICIT=1; shift ;;
    --mistral) MODE="mistral"; MODE_EXPLICIT=1; shift ;;
    --together) MODE="together"; MODE_EXPLICIT=1; shift ;;
    --nvidia) MODE="nvidia"; MODE_EXPLICIT=1; shift ;;
    --huggingface) MODE="huggingface"; MODE_EXPLICIT=1; shift ;;
    --status) status; exit 0 ;;
    --list)   catalog | sed 's/^/  /'; exit 0 ;;
    --doctor) doctor; exit 0 ;;
    --update) update; exit 0 ;;
    --reset)  rm -f "$STATE"; echo "forgot saved provider/model"; exit 0 ;;
    --uninstall) rm -rf "$DIR" "$HOME/.local/bin/claude-omni"; echo "claude-omni uninstalled"; exit 0 ;;
    --version) echo "claude-omni $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --)       shift; break ;;
    *)        break ;;
  esac
done

# Reconcile the model: an explicit -m wins; otherwise use the saved state if the
# provider wasn't switched, else the provider's default.
if [ "$MODEL_EXPLICIT" = 0 ] && [ -z "${DEFAULT_ZEN_MODEL:-}" ]; then
  if [ "$MODE_EXPLICIT" = 1 ] || [ "$FROM_STATE" = 0 ]; then
    MODEL="$(default_model)"
  fi
fi

[ -f "$DIR/.env" ] || { echo "error: $DIR/.env not found -- run install.sh" >&2; exit 1; }

start_proxy
resolve_model
save_state

export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"
export ANTHROPIC_AUTH_TOKEN="zen-local-proxy"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=128000
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export ENABLE_TOOL_SEARCH=true
unset ANTHROPIC_API_KEY

# An `env` block in ~/.claude/settings.json OVERRIDES exported environment
# variables, so on any machine that has been pointed at another relay the
# exports above are silently ignored. CLI flags outrank settings.json.
SETTINGS_JSON="$(printf '{"env":{"ANTHROPIC_MODEL":"%s","ANTHROPIC_SMALL_FAST_MODEL":"%s","ANTHROPIC_DEFAULT_OPUS_MODEL":"%s","ANTHROPIC_DEFAULT_SONNET_MODEL":"%s","ANTHROPIC_DEFAULT_HAIKU_MODEL":"%s"}}' \
  "$MODEL" "$MODEL" "$MODEL" "$MODEL" "$MODEL")"

CLAUDE_BIN="$(command -v claude || true)"
[ -n "$CLAUDE_BIN" ] || { echo "error: claude not found on PATH" >&2; exit 1; }

exec "$CLAUDE_BIN" --model "$MODEL" --settings "$SETTINGS_JSON" "$@"
